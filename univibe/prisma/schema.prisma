generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  sessions Session[]
  accounts Account[]
  profile  Profile?

  @@map("users")
}

model Session {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identifier String
  value      String
  expiresAt  DateTime

  @@index([identifier])
  @@map("verifications")
}

model Profile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  username       String  @unique
  profilePicture String?
  gender         String
  age            Int
  pronouns       String?

  college      String
  fieldOfStudy String
  semester     Int
  year         Int

  hobbies   String[]
  heardFrom String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  waitingUser        WaitingUser?
  callSessionAsUser1 CallSession[] @relation("CallUser1")
  callSessionAsUser2 CallSession[] @relation("CallUser2")

  @@map("profiles")
}

model WaitingUser {
  id        String @id @default(cuid())
  profileId String @unique
  socketId  String

  filterByGender         Boolean @default(false)
  filterGenderData       String?
  filterByCollege        Boolean @default(false)
  filterCollegeData      String?
  filterByFieldOfStudy   Boolean @default(false)
  filterFieldOfStudyData String?
  filterByYear           Boolean @default(false)
  filterYearData         Int?

  currentDomain Int @default(0) //0 = college | 2 = fieldofStudy | 3 = random

  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("waitingUser")
}

model CallSession {
  id         String @id @default(cuid())
  profile1Id String @unique
  profile2Id String @unique

  roomId    String   @unique @default(cuid())
  startedAt DateTime @default(now())

  p1FilterByGender         Boolean @default(false)
  p1FilterGenderData       String?
  p1FilterByCollege        Boolean @default(false)
  p1FilterCollegeData      String?
  p1FilterByFieldOfStudy   Boolean @default(false)
  p1FilterFieldOfStudyData String?
  p1FilterByYear           Boolean @default(false)
  p1FilterYearData         Int?
  p1CurrentDomain          Int     @default(0)

  p2FilterByGender         Boolean @default(false)
  p2FilterGenderData       String?
  p2FilterByCollege        Boolean @default(false)
  p2FilterCollegeData      String?
  p2FilterByFieldOfStudy   Boolean @default(false)
  p2FilterFieldOfStudyData String?
  p2FilterByYear           Boolean @default(false)
  p2FilterYearData         Int?
  p2CurrentDomain          Int     @default(0)

  profile1 Profile @relation("CallUser1", fields: [profile1Id], references: [id])
  profile2 Profile @relation("CallUser2", fields: [profile2Id], references: [id])

  @@map("callSession")
}
